// Auto-generated prebuilt Blueprint for prebuilts_target_framework-base
// Decoupled native frameworks/base substrate: libandroidfw, libprotoutil,
// libincfs, libincfs-utils.
//
// libutils is deliberately NOT declared here: prebuilts_target_core
// (prebuilts/target/system/core) already owns the libutils / libutils_headers
// module names. Re-declaring them here causes a Soong duplicate-module error.
// The lib64/libutils.so and lib64/libutils.a payloads are staged for runtime
// fidelity and out-of-tree linker consumption (-Llib64).
//
// Root-flattened layout per GEMINI.md:35 and shadow-conventions.md.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// -----------------------------------------------------------------------------
// Header Modules
// -----------------------------------------------------------------------------

cc_library_headers {
    name: "libandroidfw_headers",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    export_include_dirs: [
        "include",
    ],
}

cc_library_headers {
    name: "libprotoutil_headers",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    export_include_dirs: [
        "include",
    ],
}

cc_library_headers {
    name: "libincfs_headers",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    export_include_dirs: [
        "include",
    ],
}

