// -----------------------------------------------------------------------------
// Core Framework Resources
// -----------------------------------------------------------------------------

android_app_import {
    name: "framework-res",
    apk: "share/framework-res/framework-res.apk",
    srcjar: "share/framework-res/framework-res.srcjar",
    export_package_resources: true,
    preprocessed: true,
    prefer: true,
}

java_import {
